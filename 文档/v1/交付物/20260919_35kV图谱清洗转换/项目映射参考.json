  "rules": [
    {
      "@id": "czy:rule:01",
      "@type": "czy:RuleNode",
      "name": "设备老旧项目初筛规则",
      "nodeType": "规则",
      "data": {
        "definition": "基于项目的专业类别和细分码值，筛选出属于电网一次设备老旧改造范畴的项目。",
        "rule_content": "1）专业类别匹配：若“专业类别”码值 = 2（电网一次）。\n2）专业细分匹配：且“专业细分”码值 = 22。\n3）综合研判：同时满足以上两点，标记为“电网一次老旧项目”，进入下一步主变筛选。",
        "param_intro": "professionalCategory：专业类别字段。\nprofessionalSubdivison：专业细分字段。",
        "applicableObject": "电网技改/大修项目"
      }
    },
    {
      "@id": "czy:rule:02",
      "@type": "czy:RuleNode",
      "name": "主变老旧更换语义识别规则",
      "nodeType": "规则",
      "data": {
        "definition": "通过语义理解模型，分析项目名称和建设规模描述，精准识别主变更换或改造类项目，替代传统关键词匹配。",
        "rule_content": "1）语义特征提取：模型需理解文本中是否包含“针对主变压器（或主变）进行整体替换、更新、调换或大修改造”的核心业务意图。\n2）综合研判：若“项目名称”或“建设规模描述”的语义向量与上述核心意图高度相似（相似度阈值≥0.85），则标记为“主变老旧更换项目”。\n(注：此规则可自动兼容“换主变”、“变压器退运更新”、“主变增容改造”等多种非标准表述)",
        "param_intro": "prjName：项目名称字段。\nprogramScale：建设规模描述字段。\n语义相似度阈值：模型判定为同一业务意图的概率下限。",
        "applicableObject": "电网技改/大修项目"
      }
    },
    {
      "@id": "czy:rule:03",
      "@type": "czy:RuleNode",
      "name": "立项依据合规性语义剔除规则",
      "nodeType": "规则",
      "data": {
        "definition": "通过语义理解模型，分析立项依据文本，判断项目是否因电网发展或系统参数变化而改造，从而剔除暂时无法审查的项目。",
        "rule_content": "1）语义意图分析：模型需理解立项依据的核心诉求是否为“因外部电网环境变化（如负荷增长、系统容量增加、参数不匹配）导致设备无法使用”，而非“设备自身自然老化”。\n2）综合研判：若“立项依据”的语义与“因电网发展需要导致参数不满足”、“因系统变化需大修”或“抗短路能力不足”等核心语义高度相似，则剔除暂不审查，标记为“非纯老旧原因改造”。",
        "param_intro": "立项依据文本：来源于项目可研报告或立项报告。\n剔除语义库：预设的关于电网发展、系统变化、抗短路能力等外部因素的语义向量集合。",
        "applicableObject": "电网技改/大修项目"
      }
    },
    {
      "@id": "czy:rule:04",
      "@type": "czy:RuleNode",
      "name": "关联35kV主变设备筛选规则",
      "nodeType": "规则",
      "data": {
        "definition": "在项目关联设备表中，精准定位35kV电压等级的主变压器，作为后续设备本体状态评估的输入。",
        "rule_content": "1）设备类型匹配：若“关联设备类型”为“主变压器”。\n2）电压等级匹配：且“关联设备电压等级”为“35kV”。\n3）综合研判：同时满足以上两点，标记为“35kV主变关联项目”，触发主变老旧状态评估流程。",
        "param_intro": "关联设备类型：项目关联设备表字段。\n关联设备电压等级：项目关联设备表字段。",
        "applicableObject": "电网技改/大修项目"
      }
    },
    {
      "@id": "czy:rule:05",
      "@type": "czy:RuleNode",
      "name": "主变运行年限计算规则",
      "nodeType": "规则",
      "data": {
        "definition": "计算主变压器从投运到当前的累计运行时间。",
        "description": "",
        "rule_type": "",
        "rule_content": "1）运行年限 = (当前日期 - 投运日期) / 365。\n2）投运日期取自设备台账中的“投运日期”字段。\n3）结果保留一位小数。",
        "param_intro": "当前日期：执行计算时的系统日期。\n投运日期：主变压器正式投入电网运行的日期。",
        "applicableObject": "电网主变"
      }
    },
    {
      "@id": "czy:rule:06",
      "@type": "czy:RuleNode",
      "name": "主变基础参数与能效研判规则",
      "nodeType": "规则",
      "data": {
        "definition": "基于设备台账参数和运行年限，评估主变的基础服役状况和高耗能属性。",
        "rule_content": "1）超期服役：若“运行年限” >= 20年，标记为“超期服役”。\n2）高耗能设备：若“空载损耗”或“负载损耗”不满足《电力变压器能效限定值及能效等级》（GB 20052）规定的2级或3级能效要求，标记为“高耗能设备”。\n3）综合研判：同时满足以上两点，则判定为“老旧高耗能主变”，是优先改造对象。",
        "param_intro": "空载/负载损耗：主变铭牌或型式试验的基础参数。\n运行年限：通过计算规则获取。",
        "applicableObject": "电网主变"
      }
    },
    {
      "@id": "czy:rule:07",
      "@type": "czy:RuleNode",
      "name": "主变内部核心健康诊断规则",
      "nodeType": "规则",
      "data": {
        "definition": "综合各项实验报告数据，对主变内部绝缘、铁芯状况进行深度诊断。",
        "rule_content": "1）内部放电/过热：若“油色谱乙炔含量” > 5μL/L 或“总烃含量”持续增长，标记为“内部存在放电或过热风险”。\n2）绝缘严重老化：若“纸绝缘聚合度” < 250，标记为“固体绝缘严重老化”。\n3）铁芯故障：若“铁芯接地电流” > 100mA，标记为“铁芯多点接地风险”。\n4）绝缘劣化：若“绕组介质损耗因数”逼近规程临界值，标记为“绝缘受潮或整体劣化”。\n5）综合研判：触发任一条件，均表明主变存在严重内部隐患。",
        "param_intro": "油色谱数据：判断内部故障的特征气体。\n纸绝缘聚合度：判断绝缘寿命的金标准。\n铁芯接地电流：正常值通常小于100mA。",
        "applicableObject": "电网主变"
      }
    },
    {
      "@id": "czy:rule:08",
      "@type": "czy:RuleNode",
      "name": "主变外部缺陷与运行风险研判规则",
      "nodeType": "规则",
      "data": {
        "definition": "通过匹配设备缺陷隐患库，评估主变的外部可见缺陷及运行风险。",
        "rule_content": "1）严重渗漏油：若缺陷记录中包含“严重渗漏油”等，且严重等级为“严重”或“危急”，标记为“存在严重渗漏油缺陷”。\n2）部件普遍老化：若频繁出现“密封件老化”、“冷却系统故障”等缺陷，标记为“附件普遍老化”。\n3）外部过热风险：若缺陷记录包含“套管接头发热”等，且严重等级为“严重”或“危急”，标记为“外部连接点过热风险”。\n4）机械部件故障：若包含“有载开关拒动/卡涩”等，标记为“关键机械部件故障”。\n5）综合研判：触发两项及以上“严重”等级缺陷，判定为“运行风险高，需重点治理”。",
        "param_intro": "缺陷隐患记录：来源于PMS等生产管理系统。\n严重等级：通常分为“一般”、“严重”、“危急”。",
        "applicableObject": "电网主变"
      }
    },
    {
      "@id": "czy:rule:09",
      "@type": "czy:RuleNode",
      "name": "主变历史故障与抗冲击能力研判规则",
      "nodeType": "规则",
      "data": {
        "definition": "通过匹配故障记录，评估主变的历史可靠性、受损情况及抗短路冲击能力。",
        "description": "",
        "rule_type": "",
        "rule_content": "1）主体严重损坏：若故障记录显示“绕组变形”、“铁芯烧毁”等主体严重损坏，且未彻底修复，标记为“主体健康度极差”。\n2）抗短路能力不足：若故障记录中包含“近区短路冲击”，且短路冲击电流在允许短路电流的50%～70%之间累计达6次及以上，或达到90%以上，标记为“抗短路能力不足”。\n3）频繁故障：若近3年内发生2次及以上非计划停运故障，标记为“可靠性极低”。\n4）综合研判：触发任一条件，均构成重大安全隐患，是投前审查“一票否决”或优先改造的依据。",
        "param_intro": "故障记录：来源于故障事件管理系统。\n短路冲击次数：反映绕组累积机械损伤程度。",
        "applicableObject": "电网主变"
      }
    },
    {
      "@id": "czy:rule:10",
      "@type": "czy:RuleNode",
      "name": "主变电网适配性规则",
      "nodeType": "规则",
      "data": {
        "definition": "评估主变技术参数是否满足电网发展需求。",
        "rule_content": "1）电网适配性：若容量裕度不足或短路阻抗不满足电网要求，标记为“不满足电网发展需求”。",
        "applicableObject": "电网主变"
      }
    },
    {
      "@id": "czy:rule:11",
      "@type": "czy:RuleNode",
      "name": "主变家族缺陷研判规则",
      "nodeType": "规则",
      "data": {
        "definition": "评估主变是否存在先天性设计缺陷",
        "rule_content": "2）家族缺陷：若“家族缺陷标识”为“是”，且缺陷记录与之匹配，标记为“存在家族缺陷”。",
        "param_intro": "家族缺陷清单：来自设备匹配的家族性缺陷。",
        "applicableObject": "电网主变"
      }
    },
    {
      "@id": "czy:rule:12",
      "@type": "czy:RuleNode",
      "name": "项目-设备联合审查与反馈规则",
      "nodeType": "规则",
      "data": {
        "definition": "在项目完成设备关联并触发主变老旧状态评估后，若设备状态不满足老旧改造标准，系统需自动判定项目立项必要性不足，并生成标准化的反馈描述。",
        "rule_content": "1）触发条件：项目已成功通过前述筛选规则，且关联的35kV主变已完成“内部核心健康诊断”、“外部缺陷与运行风险研判”及“历史故障研判”。\n2）必要性判定：若关联主变在上述设备级评估中，未触发任何“严重”或“危急”等级的风险标签（即设备健康状态良好，无需立即进行老旧更换改造）。\n3）自动生成反馈：系统自动拦截该项目，并输出结构化描述：“立项依据不充分：经穿透审查，该项目关联的35kV主变（设备台账ID：XXX）当前运行状态良好，未检测到绝缘严重老化、主体损坏或频繁故障等符合老旧改造标准的重大隐患，当前不具备老旧更换改造的必要性，建议暂缓立项或转为常规大修维护。”",
        "param_intro": "设备级评估结果：来源于主变老旧状态评估模块输出的风险标签集合。\n设备台账ID：关联主变的唯一识别码。",
        "applicableObject": "电网技改/大修项目"
      }
    }
  ],
