      ],
      "implementation": {
        "language": "python",
        "code": "def main(rated_capacity, clusters, socs):\n    # 设备剩余电量 = Σ(簇SOC × 簇额定容量)；簇SOC 已由 Redis 节点按行取回，与簇列表顺序一致\n    remaining = 0.0\n    for cluster, soc in zip(clusters, socs):\n        remaining += float(soc) * cluster[\"capacity\"]\n    # 二期执行器将提供 redis_get / 数据库访问等运行时能力；一期只保存与检查配置\n    return {\"soc\": remaining / rated_capacity * 100}\n"
      },
      "execution": {}
    }
