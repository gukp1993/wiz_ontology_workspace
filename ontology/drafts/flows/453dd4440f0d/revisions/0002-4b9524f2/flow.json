            "kind": "nodeField",
            "nodeId": "nd-storage",
            "outputId": "out-storage",
            "fieldPath": [
              "fld-e629676078b7"
            ]
          }
        },
        {
          "id": "in-6df551fe7f73",
          "name": "sample_field",
          "label": "采样字段名",
          "type": {
            "type": "text"
          },
          "source": {
            "kind": "nodeField",
            "nodeId": "nd-storage",
            "outputId": "out-storage",
            "fieldPath": [
              "fld-0455483059c6"
            ]
          }
        },
        {
          "id": "in-e74bb8ba68b1",
          "name": "start_time",
          "label": "开始时间",
          "type": {
            "type": "datetime"
          },
          "source": {
            "kind": "flowInput",
            "inputId": "in-59b6e987b9f3"
          }
        },
        {
          "id": "in-e04c0111938a",
          "name": "end_time",
          "label": "结束时间",
          "type": {
            "type": "datetime"
          },
          "source": {
            "kind": "flowInput",
            "inputId": "in-e07383888092"
          }
        }
      ],
      "outputs": [
        {
          "id": "out-samples",
          "name": "samples",
          "label": "采样序列",
          "type": {
            "type": "list",
            "elementType": {
              "type": "object",
              "fields": [
                {
                  "id": "fld-5165e2924f0e",
                  "name": "timestamp",
                  "label": "时间戳",
                  "type": {
                    "type": "datetime"
                  }
                },
                {
                  "id": "fld-d278e9ef9c93",
                  "name": "value",
                  "label": "采样值",
                  "type": {
                    "type": "number"
                  }
                }
              ]
            }
          }
        }
      ],
      "implementation": {
        "language": "sql",
        "connectionId": "conn-6e4bedfe447e",
        "sql": "SELECT record_time, ${sample_field} AS value\nFROM ${sample_table}\nWHERE record_time >= #{start_time}\n  AND record_time < #{end_time}\nORDER BY record_time ASC"
      },
      "execution": {
        "timeoutMs": 30000,
        "maxRows": 10000
      }
    }
  ],
