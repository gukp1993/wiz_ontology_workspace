    {
      "id": "nd-point",
      "kind": "sql",
      "name": "定位测点",
      "description": "规则步骤 point：s_attr_scada 按模型/属性三元组唯一定位",
      "inputs": [
        {
          "id": "in-7d25a12273df",
          "name": "model_name",
          "label": "模型名",
          "type": {
            "type": "text"
          },
          "source": {
            "kind": "flowInput",
            "inputId": "in-981e5c4d65e8"
          }
        },
        {
          "id": "in-2f83888bc847",
          "name": "attr_name",
          "label": "属性名",
          "type": {
            "type": "text"
          },
          "source": {
            "kind": "flowInput",
            "inputId": "in-f267d30fa7f7"
          }
        },
        {
          "id": "in-8182efcb8457",
          "name": "model_id",
          "label": "模型标识",
          "type": {
            "type": "text"
          },
          "source": {
            "kind": "flowInput",
            "inputId": "in-48cee1defa5e"
          }
        }
      ],
      "outputs": [
        {
          "id": "out-point",
          "name": "point_row",
          "label": "测点行",
          "type": {
            "type": "object",
            "fields": [
              {
                "id": "fld-7063582e2433",
                "name": "scada_table",
                "label": "SCADA 表名",
                "type": {
                  "type": "text"
                }
              },
              {
                "id": "fld-bd90ef9d2a58",
                "name": "scada_id",
                "label": "SCADA 标识",
                "type": {
                  "type": "text"
                }
              }
            ]
          }
        }
      ],
      "implementation": {
        "language": "sql",
        "connectionId": "conn-6e4bedfe447e",
        "sql": "SELECT scada_table, scada_id\nFROM s_attr_scada\nWHERE model_name = #{model_name}\n  AND attr_name = #{attr_name}\n  AND model_id = #{model_id}"
      },
      "execution": {
        "timeoutMs": 30000
      }
    },
    {
      "id": "nd-storage",
      "kind": "sql",
      "name": "定位采样存储",
      "description": "规则步骤 storage：在步骤①查得的 SCADA 表按 id 定位，得采样表名与字段名",
      "inputs": [
        {
          "id": "in-5a20dec6811a",
          "name": "scada_table",
          "label": "SCADA 表名",
          "type": {
            "type": "text"
          },
          "source": {
            "kind": "nodeField",
            "nodeId": "nd-point",
            "outputId": "out-point",
            "fieldPath": [
              "fld-7063582e2433"
            ]
          }
        },
        {
          "id": "in-468036ed4b26",
          "name": "scada_id",
          "label": "SCADA 标识",
          "type": {
            "type": "text"
          },
          "source": {
            "kind": "nodeField",
            "nodeId": "nd-point",
            "outputId": "out-point",
            "fieldPath": [
              "fld-bd90ef9d2a58"
            ]
          }
        }
      ],
      "outputs": [
        {
          "id": "out-storage",
          "name": "storage_row",
          "label": "存储行",
          "type": {
            "type": "object",
            "fields": [
              {
                "id": "fld-e629676078b7",
                "name": "sample_table_name",
                "label": "采样表名",
                "type": {
                  "type": "text"
                }
              },
              {
                "id": "fld-0455483059c6",
                "name": "sample_field_name",
                "label": "采样字段名",
                "type": {
                  "type": "text"
                }
              }
            ]
          }
        }
      ],
      "implementation": {
        "language": "sql",
        "connectionId": "conn-6e4bedfe447e",
        "sql": "SELECT sample_table_name, sample_field_name\nFROM ${scada_table}\nWHERE id = #{scada_id}"
      },
      "execution": {
        "timeoutMs": 30000
      }
    },
    {
      "id": "nd-samples",
      "kind": "sql",
      "name": "读取采样记录",
      "description": "规则步骤 samples：动态采样表按 [start,end) 区间读取序列，按时间升序",
